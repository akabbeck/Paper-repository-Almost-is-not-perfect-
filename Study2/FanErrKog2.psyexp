    <Routine name="start_block_tr_p">
      <CodeComponent name="code_3">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_3" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="# send individual block triggers&amp;#10;blocktrigger = 50+nblocks&amp;#10;eegTriggerSignal(blocktrigger)" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="'''&amp;#10;response_triggers = range(101,106)+range(211,216)+range(201,206)+range(211,216)&amp;#10;# send each trigger once for analysis purposes&amp;#10;if nblocks ==1:&amp;#10;    for trig in response_triggers:&amp;#10;        eegTriggerSignal(trig)&amp;#10;        core.wait(0.02)&amp;#10;        eegTriggerSignal(10)&amp;#10;        core.wait(0.02)&amp;#10;'''&amp;#10;&amp;#10;# clear buffer&amp;#10;psychopy.event.clearEvents()" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
    </Routine>
  </Routines>
