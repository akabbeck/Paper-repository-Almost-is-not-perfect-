      <CodeComponent name="code">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="cursorCounter=0&amp;#10;cursorVariable='|'&amp;#10;captured_string=''&amp;#10;subject_response_finished=False&amp;#10;trial_clock=core.Clock()" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="var['satisfaction'].append(captured_string)" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="if cursorCounter &gt;= 30:&amp;#10;    if cursorVariable=='|':&amp;#10;        cursorVariable=' '&amp;#10;    else:&amp;#10;        cursorVariable='|'&amp;#10;    cursorCounter=0&amp;#10;cursorCounter+=1&amp;#10;&amp;#10;if subject_response_finished:&amp;#10;    final_response=captured_string&amp;#10;    continueRoutine=False&amp;#10;for key in event.getKeys(['escape','delete','backspace','1','2','3','4','5']):&amp;#10;    if key in ['return']:&amp;#10;        subject_response_finished=True&amp;#10;    elif key in ['escape']: &amp;#10;        core.quit()&amp;#10;    elif key in ['delete','backspace']:&amp;#10;        captured_string = captured_string[:-1] &amp;#10;    else: &amp;#10;        captured_string = captured_string+key" valType="extendedCode"/>
      </CodeComponent>
