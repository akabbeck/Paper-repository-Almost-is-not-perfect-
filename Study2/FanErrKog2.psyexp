    <Routine name="trial_p_practice">
      <CodeComponent name="code_p1_practice">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_p1_practice" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="# clear buffer&amp;#10;psychopy.event.clearEvents()&amp;#10;&amp;#10;# in case key response is given before arrow starts moving&amp;#10;resp_degree_code = 1&amp;#10;var['orinew_p'] = start_orientation&amp;#10;&amp;#10;&amp;#10;# frameN when arrow starts to move&amp;#10;ITIframe = int(time2move*41.25)&amp;#10;&amp;#10;&amp;#10;# tigger code when arrow starts moving&amp;#10;ITItrigger = time2move+10&amp;#10;&amp;#10;#11 Bereiche nach onset&amp;#10;velocity = var['vel_p'][-1]&amp;#10;validframes = list(range(ITIframe,ITIframe+(12*velocity),velocity))&amp;#10;&amp;#10;&amp;#10;if direction == 'left':&amp;#10;    alloris1 = [112.5, 72.0, 54.0, 36.0, 18.0, 0.0, 342.0, 324.0, 306.0, 288.0, 247.5, 202.5]&amp;#10;else:&amp;#10;    alloris1 = [ 247.5, 288.0, 306.0, 324.0, 342.0, 0.0, 18.0, 36.0, 54.0, 72.0, 112.5, 157.5]&amp;#10;&amp;#10;&amp;#10;#stop trial: set arrow and dont take responses, wait 1sec&amp;#10;if time2move == 6:&amp;#10;    eegTriggerSignal(8)&amp;#10;    arrow_practice.setOri(start_orientation)&amp;#10;    fan_practice.draw()&amp;#10;    arrow_practice.draw()&amp;#10;    red_circle_practice.draw()&amp;#10;    foto1_practice.draw()&amp;#10;    win.flip()&amp;#10;    core.wait(1)&amp;#10;    continueRoutine = False" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="#resp_degree_code schreibt für jeden frame den jeweiligen Wert für die Orientierung auf (1-12 )&amp;#10;&amp;#10;# send trigger if key is pressed&amp;#10;#response trigger=0,100,200 for left/right&amp;#10;#+15 for correct ones&amp;#10;if resp_p3_practice.keys is not None and len(resp_p3_practice.keys)&gt;0: &amp;#10;    if resp_p3_practice.corr == 1:&amp;#10;        trigger_code = eegTriggerSignal(response_trigger+15+resp_degree_code)&amp;#10;    if resp_p3_practice.corr == 0:&amp;#10;        triggercode= eegTriggerSignal(response_trigger+resp_degree_code)&amp;#10;&amp;#10;# add orientation at key press to log&amp;#10;trials_p_practice.addData(&quot;orientation_new&quot;, var['orinew_p'])&amp;#10;&amp;#10;# velocity for this trial&amp;#10;vel_thisTrial = int(var['vel_p'][-1])&amp;#10;&amp;#10;# add current velocity to log&amp;#10;trials_p_practice.addData(&quot;velocity_p&quot;, vel_thisTrial)&amp;#10;&amp;#10;#Check letzte  2 Elemente&amp;#10;adjustFrames={&amp;#10;'0.0': -1,&amp;#10;'18.0': -1,&amp;#10;'36.0': -1,&amp;#10;'342.0': -1,&amp;#10;'324.0': -1,&amp;#10;&amp;#10;'54.0': 0,&amp;#10;'72.0': 0,&amp;#10;'306.0': 0,&amp;#10;'288.0': 0,&amp;#10;&amp;#10;'112.5': 1,&amp;#10;'157.5': 1,&amp;#10;&amp;#10;'247.5': 1,&amp;#10;'202.5': 1}&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;adjustVel = adjustFrames[str(var['orinew_p'])]&amp;#10;var['vel_p'].append(vel_thisTrial+adjustVel)&amp;#10;&amp;#10;&amp;#10;if var['vel_p'][-1] &gt;10:&amp;#10;    var['vel_p'][-1] = 10&amp;#10;&amp;#10;if var['vel_p'][-1] &lt; 2:&amp;#10;    var['vel_p'][-1] = 2&amp;#10;&amp;#10;# send trigger if no key is pressed&amp;#10;if resp_p3_practice.keys is None : &amp;#10;    triggercode= eegTriggerSignal(response_trigger)" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="# send trigger when arrow starts moving&amp;#10;if frameN == ITIframe:&amp;#10;    eegTriggerSignal(ITItrigger)&amp;#10;&amp;#10;&amp;#10;&amp;#10;if frameN in validframes:&amp;#10;    arrow_practice.setOri(alloris1[0])&amp;#10;    arrow_practice.draw()&amp;#10;    win.flip()&amp;#10;    var['orinew_p'] = alloris1[0]&amp;#10;    # change trigger code according to response&amp;#10;    resp_degree_code = var['resp_'+str(var['orinew_p'])]&amp;#10;    # go to next orientation&amp;#10;    alloris1.pop(0)&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;# end routine if there was no key press 7 frames after the arrow has run through&amp;#10;if frameN == validframes[-1]+7:&amp;#10;    continueRoutine = False" valType="extendedCode"/>
      </CodeComponent>
