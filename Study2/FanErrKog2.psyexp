<?xml version="1.0" ?>
<PsychoPy2experiment encoding="utf-8" version="1.90.3">
  <Settings>
    <Param name="Monitor" updates="None" val="testMonitor" valType="str"/>
    <Param name="color" updates="None" val="#000000" valType="str"/>
    <Param name="colorSpace" updates="None" val="hex" valType="str"/>
    <Param name="Experiment info" updates="None" val="{u'session': u'', u'participant': u'', u'pressed record?': u''}" valType="code"/>
    <Param name="JS libs" updates="None" val="packaged" valType="str"/>
    <Param name="Units" updates="None" val="use prefs" valType="str"/>
    <Param name="Save excel file" updates="None" val="True" valType="bool"/>
    <Param name="Enable Escape" updates="None" val="True" valType="bool"/>
    <Param name="Save psydat file" updates="None" val="True" valType="bool"/>
    <Param name="Window size (pixels)" updates="None" val="[1920, 1080]" valType="code"/>
    <Param name="Full-screen window" updates="None" val="True" valType="bool"/>
    <Param name="blendMode" updates="None" val="avg" valType="str"/>
    <Param name="Use version" updates="None" val="1.90.3" valType="str"/>
    <Param name="HTML path" updates="None" val="html" valType="str"/>
    <Param name="Save csv file" updates="None" val="True" valType="bool"/>
    <Param name="OSF Project ID" updates="None" val="" valType="str"/>
    <Param name="Save log file" updates="None" val="True" valType="bool"/>
    <Param name="Save wide csv file" updates="None" val="True" valType="bool"/>
    <Param name="Show mouse" updates="None" val="False" valType="bool"/>
    <Param name="Data filename" updates="None" val="u'data/%s_%s_session%s_%s' % (expInfo['participant'], expName, expInfo['session'], expInfo['date'])" valType="code"/>
    <Param name="Show info dlg" updates="None" val="True" valType="bool"/>
    <Param name="expName" updates="None" val="FanAmbi" valType="str"/>
    <Param name="logging level" updates="None" val="info" valType="code"/>
    <Param name="Screen" updates="None" val="1" valType="num"/>
  </Settings>
  <Routines>
    <Routine name="generate_trials">
      <CodeComponent name="code_fp1">
        <Param name="Begin Experiment" updates="constant" val="win.mouseVisible = False&amp;#10;&amp;#10;import numpy as np&amp;#10;import math&amp;#10;import psychopy.core&amp;#10;import random&amp;#10;import csv&amp;#10;from itertools import izip&amp;#10;import random&amp;#10;import csv&amp;#10;&amp;#10;&amp;#10;&amp;#10;#Trialanzahl: 100 pro block&amp;#10;&amp;#10;# Go trials: 90%&amp;#10;# No Go trials: 10%&amp;#10;time2move = 30*[1,2,3]+ 10*[6] &amp;#10;direction = 50*['left','right'] &amp;#10;response_trigger = []&amp;#10;start_orientation = []&amp;#10;corrAnsKey = []&amp;#10;&amp;#10;&amp;#10;random.shuffle(direction)&amp;#10;&amp;#10;for j,i in zip(direction,time2move):&amp;#10;    if j == 'left':&amp;#10;        corrAnsKey.append('b')&amp;#10;        start_orientation.append('157.5')&amp;#10;        if i == 6:&amp;#10;            response_trigger.append(0)&amp;#10;        else: &amp;#10;            response_trigger.append(100)&amp;#10;&amp;#10;    if j == 'right':&amp;#10;        corrAnsKey.append('f')&amp;#10;        start_orientation.append('202.5')&amp;#10;        if i == 6:&amp;#10;            response_trigger.append(0)&amp;#10;        else:&amp;#10;            response_trigger.append(200)&amp;#10;&amp;#10;&amp;#10;&amp;#10;# zip lists together &amp;#10;all = list(zip(time2move,direction,response_trigger,start_orientation,corrAnsKey))&amp;#10;time2move,direction,response_trigger,start_orientation,corrAnsKey = zip(*all)&amp;#10;&amp;#10;&amp;#10;var = {&amp;#10;'vel':[5], # start velocity, 5frames per second&amp;#10;'vel_p':[5],&amp;#10;'resp_0.0': 7#code for responses&amp;#10;&amp;#10;} &amp;#10;&amp;#10;for j in direction:&amp;#10;    if j == 'left':&amp;#10;        var['resp_157.5'] = 1&amp;#10;        var['resp_112.5']= 2&amp;#10;        var['resp_72.0']= 3&amp;#10;        var['resp_54.0']= 4&amp;#10;        var['resp_36.0']= 5&amp;#10;        var['resp_18.0']= 6&amp;#10;        var['resp_342.0']= 8&amp;#10;        var['resp_324.0']= 9&amp;#10;        var['resp_306.0']= 10&amp;#10;        var['resp_288.0']= 11&amp;#10;        var['resp_247.5']= 12&amp;#10;        var['resp_205.5']= 13&amp;#10;&amp;#10;    elif j == 'right':&amp;#10;        var['resp_157.5'] = 13&amp;#10;        var['resp_112.5']= 12&amp;#10;        var['resp_72.0']= 11&amp;#10;        var['resp_54.0']= 10&amp;#10;        var['resp_36.0']= 9&amp;#10;        var['resp_18.0']= 8&amp;#10;        var['resp_342.0']= 6&amp;#10;        var['resp_324.0']= 5&amp;#10;        var['resp_306.0']= 4&amp;#10;        var['resp_288.0']= 3&amp;#10;        var['resp_247.5']= 2&amp;#10;        var['resp_205.5']= 1&amp;#10;&amp;#10;#time2move &amp; direction max repetition: 3 trials&amp;#10;&amp;#10;# randomize with constraints functions&amp;#10;def valid_duplicate_spacing_p(x):&amp;#10;    for i,elem in izip(xrange(0,len(x)-3),x):&amp;#10;        if (elem[0] == x[i+1][0] and elem[0] == x[i+2][0] and elem[0] == x[i+3][0]) or (elem[1] == x[i+1][1] and elem[1] == x[i+2][1] and elem[1] == x[i+3][1]):&amp;#10;            return False&amp;#10;    return True&amp;#10;&amp;#10;def sample_permutations_with_duplicate_spacing_p(seq):&amp;#10;    random.shuffle(seq)&amp;#10;    while not valid_duplicate_spacing_p(seq):&amp;#10;        random.shuffle(seq)&amp;#10;    return seq&amp;#10;&amp;#10;#Blöcke und Übungstrials&amp;#10;&amp;#10;&amp;#10;&amp;#10;for number in range(1,6):&amp;#10;    if number &lt;=4:&amp;#10;        e = all[:]&amp;#10;    else:&amp;#10;        e = all[:10]&amp;#10;    # randomize until no constraints are met&amp;#10;    sample_permutations_with_duplicate_spacing_p(e)&amp;#10;&amp;#10;    current_name = 'blocks\\block_p_'+str(number)+'.csv'&amp;#10;    with open(current_name,'wb') as out:&amp;#10;        csv_out=csv.writer(out)&amp;#10;        csv_out.writerow(['time2move','direction','response_trigger','start_orientation','corrAnsKey'])&amp;#10;        for row in e:&amp;#10;            csv_out.writerow(row) " valType="extendedCode"/>
        <Param name="name" updates="None" val="code_fp1" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
      <CodeComponent name="triggers">
        <Param name="Begin Experiment" updates="constant" val="from psychopy import parallel&amp;#10;parallel.setPortAddress(0x3FF8)&amp;#10;&amp;#10;&amp;#10;def eegTriggerSignal(code):&amp;#10;&amp;#10;    if code!=-1:&amp;#10;        parallel.setData(int(code))&amp;#10;        core.wait(0.006) # wait betwwen trigger and trigger deletion&amp;#10;        parallel.setData(0)&amp;#10;        logging.data('EEG_Trigger: ' , str(code))&amp;#10;        thisExp.addData('EEG_Trigger', str(code))&amp;#10;    else:&amp;#10;        parallel.setData(int(255))&amp;#10;        core.wait(0.006) # wait betwwen trigger and trigger deletion&amp;#10;        parallel.setData(0)&amp;#10;        logging.data('EEG_Trigger:', ' Fehler in Routine')&amp;#10;&amp;#10;#experiment start S1&amp;#10;eegTriggerSignal(230) " valType="extendedCode"/>
        <Param name="name" updates="None" val="triggers" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
    </Routine>
    <Routine name="ITI_p_practice">
      <StaticComponent name="ITI_practice">
        <Param name="code" updates="None" val="" valType="code"/>
        <Param name="name" updates="None" val="ITI_practice" valType="code"/>
        <Param name="stopVal" updates="constant" val="1.25" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="stopType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="1" valType="code"/>
      </StaticComponent>
    </Routine>
    <Routine name="resp_ITI_f">
      <KeyboardComponent name="resp">
        <Param name="correctAns" updates="constant" val="$corrAns" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="True" valType="bool"/>
        <Param name="name" updates="None" val="resp" valType="code"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="forceEndRoutine" updates="constant" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="discard previous" updates="constant" val="True" valType="bool"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="allowedKeys" updates="constant" val="'y','m'" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="store" updates="constant" val="last key" valType="str"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="block_feed_f">
      <TextComponent name="block_feed_msg">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="block_feed_msg" valType="code"/>
        <Param name="wrapWidth" updates="constant" val="" valType="code"/>
        <Param name="color" updates="constant" val="white" valType="str"/>
        <Param name="text" updates="set every repeat" val="$msg2" valType="str"/>
        <Param name="stopVal" updates="constant" val="2" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="code"/>
        <Param name="flip" updates="constant" val="" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="font" updates="constant" val="Arial" valType="str"/>
        <Param name="letterHeight" updates="constant" val="0.1" valType="code"/>
      </TextComponent>
      <CodeComponent name="code_f2">
        <Param name="Begin Experiment" updates="constant" val="msg2 = 'no update'&amp;#10;nErr = 0" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_f2" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="nCorr = trials_f.data['resp_f3.corr'].sum()&amp;#10;nErr = 30-nCorr&amp;#10;ERR = int(nErr)&amp;#10;&amp;#10;&amp;#10;msg2 = 'Sie hast in diesem Block '+str(ERR)+' Fehler gemacht.'&amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
      <ParallelOutComponent name="p_port_8">
        <Param name="name" updates="None" val="p_port_8" valType="code"/>
        <Param name="syncScreen" updates="constant" val="True" valType="bool"/>
        <Param name="stopData" updates="None" val="0" valType="code"/>
        <Param name="stopVal" updates="constant" val="0.1" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="address" updates="None" val="0xE010" valType="str"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="startData" updates="None" val="140" valType="code"/>
      </ParallelOutComponent>
    </Routine>
    <Routine name="check">
      <CodeComponent name="code_11">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_11" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="if trials_p_practice.thisTrialN &gt; 0 and resp_p3_practice.keys is None :&amp;#10;    trials_p_practice.thisTrialN -= 1" valType="extendedCode"/>
      </CodeComponent>
    </Routine>
    <Routine name="slow">
      <CodeComponent name="code_10">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_10" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="if resp_p3.keys is None and not time2move == 6: &amp;#10;    continueRoutine = True&amp;#10;    eegTriggerSignal(response_trigger)&amp;#10;else: &amp;#10;    continueRoutine = False" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
      <ImageComponent name="image_slow">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="image_slow" valType="code"/>
        <Param name="color" updates="constant" val="$[1,1,1]" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="mask" updates="constant" val="None" valType="str"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="code"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="texture resolution" updates="constant" val="128" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.01" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="constant" val="img\5.png" valType="str"/>
        <Param name="size" updates="constant" val="(1.5, 1.5)" valType="code"/>
      </ImageComponent>
      <KeyboardComponent name="key_resp_5">
        <Param name="correctAns" updates="constant" val="" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="False" valType="bool"/>
        <Param name="name" updates="None" val="key_resp_5" valType="code"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="forceEndRoutine" updates="constant" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="discard previous" updates="constant" val="True" valType="bool"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="allowedKeys" updates="constant" val="'space', 'f', 'b'" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.01" valType="code"/>
        <Param name="store" updates="constant" val="nothing" valType="str"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="end">
      <CodeComponent name="code_12">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_12" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="core.wait(0.5)&amp;#10;eegTriggerSignal (241)&amp;#10;win.mouseVisible = True" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
      </CodeComponent>
      <ImageComponent name="fan_end">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="fan_end" valType="code"/>
        <Param name="color" updates="constant" val="$[1,1,1]" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="mask" updates="constant" val="None" valType="str"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="code"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="pix" valType="str"/>
        <Param name="texture resolution" updates="constant" val="128" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="constant" val="img\stimulus.png" valType="str"/>
        <Param name="size" updates="constant" val="(600, 600)" valType="code"/>
      </ImageComponent>
      <ImageComponent name="arrow_end">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="arrow_end" valType="code"/>
        <Param name="color" updates="constant" val="$[1,1,1]" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="mask" updates="constant" val="None" valType="str"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="code"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="pix" valType="str"/>
        <Param name="texture resolution" updates="constant" val="128" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="set every repeat" val="orient_end" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="constant" val="img\arrowOnly.png" valType="str"/>
        <Param name="size" updates="constant" val="(25, 580)" valType="code"/>
      </ImageComponent>
      <ImageComponent name="circe_end">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="circe_end" valType="code"/>
        <Param name="color" updates="constant" val="$[1,1,1]" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="mask" updates="constant" val="None" valType="str"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="code"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="texture resolution" updates="constant" val="128" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="constant" val="img\circle.png" valType="str"/>
        <Param name="size" updates="constant" val="(0.042, 0.07)" valType="code"/>
      </ImageComponent>
      <TextComponent name="ques_end">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="name" updates="None" val="ques_end" valType="code"/>
        <Param name="wrapWidth" updates="constant" val="" valType="code"/>
        <Param name="color" updates="constant" val="white" valType="str"/>
        <Param name="text" updates="constant" val="Wenn sich das Pendel im Uhrzeigersinn gedreht hat und du das Pendel an dieser Stelle gestoppt hast, wie hast du deine Leistung bewertet? &amp;#10;Benutze die Maus um auszuwählen. " valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="pos" updates="constant" val="(0, 0.7)" valType="code"/>
        <Param name="flip" updates="constant" val="" valType="str"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="font" updates="constant" val="Arial" valType="str"/>
        <Param name="letterHeight" updates="constant" val="0.065" valType="code"/>
      </TextComponent>
      <RatingScaleComponent name="rating_end">
        <Param name="labels" updates="constant" val="" valType="str"/>
        <Param name="pos" updates="constant" val="0, -0.6" valType="str"/>
        <Param name="high" updates="constant" val="6" valType="code"/>
        <Param name="storeRating" updates="constant" val="True" valType="bool"/>
        <Param name="marker" updates="constant" val="triangle" valType="str"/>
