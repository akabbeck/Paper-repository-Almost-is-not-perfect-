    <Routine name="early">
      <CodeComponent name="code_14">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_14" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="if resp_degree_code == 1 and not eegTriggerSignal == 9 and not time2move == 6: &amp;#10;    continueRoutine = True&amp;#10;else: &amp;#10;    continueRoutine = False" valType="extendedCode"/>
