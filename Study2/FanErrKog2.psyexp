    <Routine name="trial_p">
      <CodeComponent name="code_p1">
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="name" updates="None" val="code_p1" valType="code"/>
        <Param name="Begin Routine" updates="constant" val="if trials_p.thisTrialN == 0:&amp;#10;    eegTriggerSignal(3)&amp;#10;    core.wait(0.5)&amp;#10;&amp;#10;&amp;#10;# clear buffer&amp;#10;psychopy.event.clearEvents()&amp;#10;&amp;#10;# in case key response is given before arrow starts moving&amp;#10;resp_degree_code = 1&amp;#10;var['orinew'] = start_orientation&amp;#10;&amp;#10;#stop trial: set arrow and dont take responses&amp;#10;if time2move == 6:&amp;#10;    eegTriggerSignal(5)&amp;#10;    arrow.setOri(start_orientation)&amp;#10;    fan.draw()&amp;#10;    arrow.draw()&amp;#10;    red_circle.draw()&amp;#10;    foto1.draw()&amp;#10;    win.flip()&amp;#10;    core.wait(1)&amp;#10;    eegTriggerSignal(14)&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;&amp;#10;# frameN when arrow starts to move&amp;#10;ITIframe = int(time2move*41.25)&amp;#10;&amp;#10;&amp;#10;# tigger code when arrow starts moving&amp;#10;ITItrigger = time2move+10&amp;#10;&amp;#10;&amp;#10;velocity = var['vel'][-1]&amp;#10;#with which frame should arrow move&amp;#10;validframes = list(range(ITIframe,ITIframe+(12*velocity),velocity))&amp;#10;&amp;#10;if direction == 'left':&amp;#10;    alloris1 = [112.5, 72.0, 54.0, 36.0, 18.0, 0.0, 342.0, 324.0, 306.0, 288.0, 247.5, 202.5]&amp;#10;else:&amp;#10;    alloris1 = [ 247.5, 288.0, 306.0, 324.0, 342.0, 0.0, 18.0, 36.0, 54.0, 72.0, 112.5, 157.5]&amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="# send trigger if key is pressed&amp;#10;#response trigger=0,100,200 for left/right&amp;#10;#+15 for correct ones&amp;#10;if resp_p3_practice.keys is not None and len(resp_p3_practice.keys)&gt;0: &amp;#10;    if resp_p3_practice.corr == 1:&amp;#10;        trigger_code = eegTriggerSignal(response_trigger+15+resp_degree_code)&amp;#10;    if resp_p3_practice.corr == 0:&amp;#10;        triggercode= eegTriggerSignal(response_trigger+resp_degree_code)&amp;#10;&amp;#10;&amp;#10;# add orientation at key press to log&amp;#10;trials_p.addData(&quot;orientation_new&quot;, var['orinew'])&amp;#10;&amp;#10;# velocity for this trial&amp;#10;vel_thisTrial = int(var['vel'][-1])&amp;#10;&amp;#10;# add current velocity to log&amp;#10;trials_p.addData(&quot;velocity&quot;, vel_thisTrial)&amp;#10;&amp;#10;&amp;#10;#adjust velocity&amp;#10;#Check letzte  2 Elemente&amp;#10;adjustFrames={&amp;#10;'0.0': -1,&amp;#10;'18.0': -1,&amp;#10;'36.0': -1,&amp;#10;'342.0': -1,&amp;#10;'324.0': -1,&amp;#10;&amp;#10;'54.0': 0,&amp;#10;'72.0': 0,&amp;#10;'306.0': 0,&amp;#10;'288.0': 0,&amp;#10;&amp;#10;'112.5': 1,&amp;#10;'157.5': 1,&amp;#10;&amp;#10;'247.5': 1,&amp;#10;'202.5': 1}&amp;#10;&amp;#10;&amp;#10;&amp;#10;if not time2move == 6: # exclude stop trials for this&amp;#10;    adjustVel = adjustFrames[str(var['orinew'])]&amp;#10;    var['vel'].append(vel_thisTrial+adjustVel)&amp;#10;&amp;#10;&amp;#10;if var['vel'][-1] &gt;10:&amp;#10;    var['vel'][-1] = 10&amp;#10;&amp;#10;if var['vel'][-1] &lt; 2:&amp;#10;    var['vel'][-1] = 2&amp;#10;&amp;#10;&amp;#10;arrow.setOpacity(1)&amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each Frame" updates="constant" val="# send trigger when arrow starts moving&amp;#10;if not time2move == 6 and frameN == ITIframe:&amp;#10;    eegTriggerSignal(ITItrigger)&amp;#10;&amp;#10;&amp;#10;&amp;#10;if frameN in validframes:&amp;#10;    if not time2move == 6:&amp;#10;        arrow.setOri(alloris1[0])&amp;#10;        arrow.draw()&amp;#10;        win.flip()&amp;#10;        var['orinew'] = alloris1[0]&amp;#10;        # change trigger code according to response&amp;#10;        resp_degree_code = var['resp_'+str(var['orinew'])]&amp;#10;        # go to next orientation&amp;#10;        alloris1.pop(0)&amp;#10;        arrow.setOpacity(0)&amp;#10;    else:&amp;#10;        resp_degree_code = 0&amp;#10;&amp;#10;&amp;#10;&amp;#10;# end routine if there was no key press &amp;#10;if frameN == validframes[-1]+velocity:&amp;#10;    continueRoutine = False&amp;#10;    eegTriggerSignal(9)" valType="extendedCode"/>
      </CodeComponent>
      <ImageComponent name="fan">
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
